# Phase01 binds loopback ONLY; do not expose to LAN until Phase02 gateway security.
HOST=127.0.0.1
PORT=6060
LOG_LEVEL=info
SQLITE_PATH=./data/adapter.sqlite

# Optional local Control Center owner login. Leave all blank to keep auth and
# diagnostics routes unmounted. Never commit real values to this file.
# Generate the password hash with apps/adapter/scripts/hash-owner-password.mjs.
GRIMMLINK_OWNER_PASSWORD_HASH=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
GRIMMLINK_SESSION_SIGNING_KEY=
# For the Vite development UI, set this to http://127.0.0.1:5173.
GRIMMLINK_PUBLIC_ORIGIN=
