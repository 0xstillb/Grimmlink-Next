{
    admin off
    auto_https off
}

# Phase02 contract sandbox ONLY. Loopback host 6060. No Official upstream exists.
# NEVER promote this file to production: public TLS/SNI and Spring runtime ACL
# verification are separate hard gates. All Official UI/OPDS/KO routes remain DENIED.
:6060 {
    @local_host {
        host localhost 127.0.0.1
    }

    @adapter_get {
        method GET
        path /health /openapi.json /api/grimmlink/v2/capabilities /api/grimmlink/v2/version
    }

    # Owner credentials and session cookies cross this fixed same-origin path allowlist only.
    # The Adapter still enforces exact route methods, owner sessions, Origin and CSRF.
    @adapter_private_api {
        method GET POST PUT DELETE
        path /api/grimmlink/v2/local/auth/session /api/grimmlink/v2/local/auth/login /api/grimmlink/v2/local/auth/logout /api/grimmlink/v2/local/diagnostics/adapter/logs /api/grimmlink/v2/local/diagnostics/adapter/lease /api/grimmlink/v2/local/support-bundle /api/grimmlink/v2/local/support-bundle/*
    }

    route {
        handle @local_host {
            handle @adapter_private_api {
                reverse_proxy 127.0.0.1:6061 {
                    # Never pass inbound Authorization or proxy-rewrite identity.
                    # Cookie, Origin and X-CSRF-Token are needed by the fixed local auth routes.
                    header_up -Authorization
                    header_up -X-Auth-Key
                    header_up -X-Auth-User
                    header_up -Proxy-Authorization
                    header_up -Forwarded
                    header_up -X-Forwarded-For
                    header_up -X-Forwarded-Host
                    header_up -X-Forwarded-Proto
                    header_up -X-Forwarded-Prefix
                    header_up -X-Original-URL
                    header_up -X-Rewrite-URL
                }
            }
            handle @adapter_get {
                reverse_proxy 127.0.0.1:6061 {
                    # Never pass inbound identity or proxy-rewrite headers.
                    header_up -Authorization
                    header_up -Cookie
                    header_up -X-Auth-Key
                    header_up -X-Auth-User
                    header_up -Proxy-Authorization
                    header_up -Forwarded
                    header_up -X-Forwarded-For
                    header_up -X-Forwarded-Host
                    header_up -X-Forwarded-Proto
                    header_up -X-Forwarded-Prefix
                    header_up -X-Original-URL
                    header_up -X-Rewrite-URL
                }
            }
            respond "UPSTREAM_DENIED" 403
        }
        respond "INVALID_HOST" 421
    }
}
